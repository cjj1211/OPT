*{outline:0px;}

QPushButton {
    font-family: Source Han Sans CN;
    font-weight: normal;
}

QPushButton::disabled {
    background: #CCCCCC;
}

QPushButton {
    background: #1890ff;
    border-radius: 4px;
    font-size: 16px;
    color: rgba(255,255,255,0.85);
}

QPushButton::hover {
    background: rgba(24, 144, 255,0.8) ;
    border-radius: 4px;
    font-size: 16px;
    color: rgba(255,255,255,1.0);
}

QComboBox
{
    background-color: rgba(255,255,255,0.00);
    border-radius: 2px;
    border: 1px solid rgba(255,255,255,0.60);
    font-size: 14px;
    font-weight: normal;
    color: #ffffff;
}

QComboBox:disabled
{
	background-color:rgba(50,50,50,200);
    color:rgb(160,160,160);
}


/* QComboBox:hover
{
	background-color:rgba(45,45,45,200);
	border:1px solid rgb(31,156,220) ;
} */

QComboBox:on
{
	border-radius:3px;
	/*background-color:rgba(35,35,35);*/
	font: 75 9pt "Microsoft YaHei";
    color:rgb(255,255,255);
    /*border:1px solid rgb(31,156,220) ;*/
}

QComboBox QAbstractItemView 
{
    outline: 0px solid gray;  
    /*border: 1px solid rgb(31,156,220); */ 
    font: 75 9pt "Microsoft YaHei";
    color: rgb(255,255,255);
    background-color: #162455;
    selection-background-color: #1890FF;   
    border-radius: 4px;
    border: 1px solid #1890FF;
}

QComboBox QAbstractItemView::item
{ 
	height: 25px;  

}

QComboBox QAbstractItemView::item:hover
{ 
	background-color: #1890FF; 
}

QComboBox QAbstractItemView::item:selected 
{
    color: rgb(255,255,255);
	background-color: #1890FF; 
}

QComboBox::drop-down
{
	border:none;
}

QComboBox::down-arrow 
{
    right:10px;
    width: 9px;  
    height: 9px;   
    image: url(./images/trainPage/down.svg)
}


QComboBox::down-arrow:on
{
    width: 9px;  
    height: 9px;   
    image: url(./images/trainPage/down.svg)
}

QLabel {
    font-weight: normal;
}

QCheckBox{
	font-size: 18px;
	font-weight: normal;
	color: white;
}

QCheckBox::indicator{
    background-color: rgba(255, 255, 255, 0);
    border: 0px solid #b1b1b1;
	width: 20px;
	height: 20px;
}

QCheckBox:enabled:checked{
	color: rgb(255, 255, 255);
}


/*
QCheckBox:enabled:hover{
 	color: rgb(0, 200, 0);
}
*/

QCheckBox::indicator:unchecked {
    border-image: url(./images/trainPage/unchecked.svg)
}
