/ {
	chosen {
		nordic,nus-uart = &uart0;
		/delete-property/ zephyr,ieee802154;
	};

	zephyr,user {
		ctrl-gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>,
					 <&gpio0 25 GPIO_ACTIVE_HIGH>,
					 <&gpio0 29 0>;
		TP-gpios = <&gpio0 31 0>, <&gpio1 12 0>, <&gpio1 4 0>, <&gpio1 5 0>;
		io-channels = <&adc 0>;
		trig-gpios = <&gpio0 28 GPIO_ACTIVE_LOW>;
		ICE-gpios = <&gpio1 7 GPIO_ACTIVE_LOW>, <&gpio1 8 0>;
	};

	aliases {
		/delete-property/ sw0;
		/delete-property/ sw1;
		/delete-property/ sw2;
		/delete-property/ sw3;
		/delete-property/ mcuboot-button0;
		/delete-property/ spi-flash0;
		/delete-property/ pwm-led0;
		/delete-property/ led0;
		/delete-property/ led1;
		/delete-property/ led2;
		/delete-property/ led3;
		/delete-property/ bootloader-led0;
		/delete-property/ mcuboot-led0;
	};
};

/delete-node/ &arduino_adc;
/delete-node/ &arduino_header;
/delete-node/ &{/buttons/};
/delete-node/ &{/leds/};
/delete-node/ &qspi;
/delete-node/ &{/pwmleds/};
/delete-node/ &pwm0;
/delete-node/ &{/nrf-gpio-forwarder/uart/};
/delete-node/ &gpio_fwd;

&uart0_default {
	group1 {
		psels = <NRF_PSEL(UART_TX, 1, 1)>;
	};

	group2 {
		psels = <NRF_PSEL(UART_RX, 1, 0)>;
	};
};

&uart0_sleep {
	group1 {
		psels = <NRF_PSEL(UART_TX, 1, 1)>, <NRF_PSEL(UART_RX, 1, 0)>;
	};
};

&spi4 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi4_default>;
	pinctrl-1 = <&spi4_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio0 11 GPIO_ACTIVE_LOW>;
	ice40: fpga@0 {
		compatible ="lattice,spi-fpga";
		reg = <0x0>;
		spi-max-frequency = <DT_FREQ_M(8)>;
	};
};
&spi4_default {
	group1 {
		psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
				<NRF_PSEL(SPIM_MISO, 0, 10)>,
				<NRF_PSEL(SPIM_MOSI, 0, 9)>;
	};
};

&spi4_sleep {
	group1 {
		psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
				<NRF_PSEL(SPIM_MISO, 0, 10)>,
				<NRF_PSEL(SPIM_MOSI, 0, 9)>;
	};
};

&i2c1 {
	// clock-frequency = <I2C_BITRATE_FAST>;

	sensor_tmp119: tmp119@48 {
		compatible = "i2c-device";
		reg = <0x48>;
	};

	bq27427@55 {
		compatible = "ti,bq274xx";
		reg = <0x55>;
		design-voltage = <4200>;
		design-capacity = <250>;
		taper-current = <25>;
		terminate-voltage = <3200>;
		chemistry-id = <0x1202>;
	};
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <0>;
		zephyr,resolution = <12>;
		zephyr,input-positive = <NRF_SAADC_AIN0>;
	};
};

&wdt {
	status = "okay";
};
&rtc0 {
	status = "okay";
	clock-frequency = <32768>;
	prescaler = <1>;
};
