   <string notr="true">#Header{
	background-color: rgb(0, 0, 0);
	padding: 0px;
	margin: 0px;
}

QPushButton {
	height: 56px;
	width: 113px;
	margin: -1px;
	background: rgba(255,255,255,0.00);
	font-size: 18px;
	font-weight: bold;

	color: rgba(255,255,255,0.80);
}

QPushButton::hover {
	height: 56px;
	width: 113px;
	margin: -1px;
	background: rgba(255,255,255,0.2);
	font-size: 18px;
	font-weight: bold;
	color: rgba(255,255,255,1.0);
}

QPushButton::checked {
	width: 113px;
	height: 56px;
	background: #132666;
	border: 2px solid #2843A4;
	font-size: 18px;
	font-weight: bold;
	color: #ffffff;
}

</string>
